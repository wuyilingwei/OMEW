{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "openmew-server",
  "main": "src/api.ts",
  "compatibility_date": "2026-08-18",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOM_DO", "class_name": "RoomDO" },
      { "name": "STRONGHOLD_DO", "class_name": "StrongholdDO" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RoomDO", "StrongholdDO"] }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "openmew",
      "database_id": "6ec2421a-2a72-46d6-acd2-f6356b738772",
      "migrations_dir": "migrations"
    }
  ],
  "assets": {
    "directory": "../web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/auth/*", "/stronghold", "/stronghold/*", "/inbox", "/inbox/*"]
  },
  "routes": [
    { "pattern": "omew.wuyilingwei.com", "custom_domain": true }
  ]
}
