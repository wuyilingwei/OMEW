{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "openmew-server",
  "main": "src/api.ts",
  "compatibility_date": "2026-08-18",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOM_DO", "class_name": "RoomDO" },
      { "name": "STRONGHOLD_DO", "class_name": "StrongholdDO" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RoomDO", "StrongholdDO"] }
  ],
  "vars": {
    "INSTANCE_DOMAIN": "omew.wuyilingwei.com",
    // m0-protocol §7.9: instance policy as deployment env config - see
    // server/src/config.ts for parsing and .dev.vars.example for local overrides.
    "ALLOW_ROOT": "1",
    "ROOT_REQUIREMENTS": "",
    "TRUSTED_IDENTITY_SERVERS": "*",
    "FEDERATION_PEERS": "",
    "STRONGHOLD_CREATION": "open",
    "STRONGHOLD_CREATORS": "",
    "ALLOW_GUEST_BROWSING": "1",
    "MAX_FILE_BYTES": "10485760",
    "USER_STORAGE_QUOTA_BYTES": "209715200"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "openmew",
      "database_id": "6ec2421a-2a72-46d6-acd2-f6356b738772",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "omew-media" }
  ],
  "assets": {
    "directory": "../web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/federation/*", "/stronghold", "/stronghold/*", "/inbox", "/inbox/*"]
  },
  "routes": [
    { "pattern": "omew.wuyilingwei.com", "custom_domain": true }
  ]
}
